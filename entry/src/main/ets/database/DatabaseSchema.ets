/**
 * 数据库 Schema 定义(版本 1)
 *
 * 所有建表、建索引 SQL 集中管理,保证:
 * - 使用 IF NOT EXISTS,可重复执行
 * - 表名/列名/索引名只引用 DatabaseConstants
 * - 不依赖用户输入
 * - 不包含 API Key / Provider Secret / 用户正文
 * - 包含 unique 索引约束 sequence_number 唯一
 */

import {
  TABLE_CHARACTERS,
  TABLE_CHATS,
  TABLE_MESSAGES,
  TABLE_LOREBOOKS,
  TABLE_LOREBOOK_ENTRIES,
  INDEX_CHATS_UPDATED_AT,
  INDEX_CHATS_CHARACTER_ID,
  INDEX_MESSAGES_CHAT_SEQUENCE,
  INDEX_MESSAGES_CHAT_CREATED,
  INDEX_LOREBOOKS_UPDATED_AT,
  INDEX_LOREBOOKS_ENABLED,
  INDEX_LOREBOOK_ENTRIES_LOREBOOK_ID,
  INDEX_LOREBOOK_ENTRIES_LOREBOOK_PRIORITY,
  COLUMN_ID,
  COLUMN_NAME,
  COLUMN_DESCRIPTION,
  COLUMN_PERSONALITY,
  COLUMN_SCENARIO,
  COLUMN_FIRST_MESSAGE,
  COLUMN_SYSTEM_PROMPT,
  COLUMN_AVATAR_URI,
  COLUMN_CREATED_AT,
  COLUMN_UPDATED_AT,
  COLUMN_CHARACTER_ID,
  COLUMN_TITLE,
  COLUMN_LAST_MESSAGE_AT,
  COLUMN_IS_ARCHIVED,
  COLUMN_CHAT_ID,
  COLUMN_ROLE,
  COLUMN_CONTENT,
  COLUMN_STATUS,
  COLUMN_SEQUENCE_NUMBER,
  COLUMN_ERROR_MESSAGE,
  COLUMN_IS_STREAMING,
  COLUMN_SOURCE,
  COLUMN_LOREBOOK_ID,
  COLUMN_LOREBOOK_NAME,
  COLUMN_LOREBOOK_DESCRIPTION,
  COLUMN_LOREBOOK_ENABLED,
  COLUMN_LOREBOOK_CREATED_AT,
  COLUMN_LOREBOOK_UPDATED_AT,
  COLUMN_ENTRY_ID,
  COLUMN_ENTRY_LOREBOOK_ID,
  COLUMN_ENTRY_NAME,
  COLUMN_ENTRY_KEYS_JSON,
  COLUMN_ENTRY_SECONDARY_KEYS_JSON,
  COLUMN_ENTRY_CONTENT,
  COLUMN_ENTRY_ENABLED,
  COLUMN_ENTRY_CONSTANT,
  COLUMN_ENTRY_SELECTIVE,
  COLUMN_ENTRY_POSITION,
  COLUMN_ENTRY_PRIORITY,
  COLUMN_ENTRY_CREATED_AT,
  COLUMN_ENTRY_UPDATED_AT
} from './DatabaseConstants';

const CREATE_CHARACTERS_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_CHARACTERS} (` +
  `${COLUMN_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_NAME} TEXT NOT NULL, ` +
  `${COLUMN_DESCRIPTION} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_PERSONALITY} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_SCENARIO} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_FIRST_MESSAGE} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_SYSTEM_PROMPT} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_AVATAR_URI} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_UPDATED_AT} INTEGER NOT NULL` +
  `)`;

const CREATE_CHATS_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_CHATS} (` +
  `${COLUMN_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_CHARACTER_ID} TEXT, ` +
  `${COLUMN_TITLE} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_UPDATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_LAST_MESSAGE_AT} INTEGER NOT NULL DEFAULT 0, ` +
  `${COLUMN_IS_ARCHIVED} INTEGER NOT NULL DEFAULT 0` +
  `)`;

const CREATE_MESSAGES_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_MESSAGES} (` +
  `${COLUMN_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_CHAT_ID} TEXT NOT NULL, ` +
  `${COLUMN_ROLE} TEXT NOT NULL, ` +
  `${COLUMN_CONTENT} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_STATUS} TEXT NOT NULL, ` +
  `${COLUMN_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_UPDATED_AT} INTEGER, ` +
  `${COLUMN_SEQUENCE_NUMBER} INTEGER NOT NULL, ` +
  `${COLUMN_ERROR_MESSAGE} TEXT, ` +
  `${COLUMN_IS_STREAMING} INTEGER NOT NULL DEFAULT 0, ` +
  `${COLUMN_SOURCE} TEXT` +
  `)`;

const CREATE_INDEX_CHATS_UPDATED_AT: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_CHATS_UPDATED_AT} ON ${TABLE_CHATS}(${COLUMN_UPDATED_AT})`;

const CREATE_INDEX_CHATS_CHARACTER_ID: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_CHATS_CHARACTER_ID} ON ${TABLE_CHATS}(${COLUMN_CHARACTER_ID})`;

const CREATE_INDEX_MESSAGES_CHAT_SEQUENCE: string =
  `CREATE UNIQUE INDEX IF NOT EXISTS ${INDEX_MESSAGES_CHAT_SEQUENCE} ` +
  `ON ${TABLE_MESSAGES}(${COLUMN_CHAT_ID}, ${COLUMN_SEQUENCE_NUMBER})`;

const CREATE_INDEX_MESSAGES_CHAT_CREATED: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_MESSAGES_CHAT_CREATED} ` +
  `ON ${TABLE_MESSAGES}(${COLUMN_CHAT_ID}, ${COLUMN_CREATED_AT})`;

// ===== v2: Lorebooks Table =====
const CREATE_LOREBOOKS_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_LOREBOOKS} (` +
  `${COLUMN_LOREBOOK_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_LOREBOOK_NAME} TEXT NOT NULL, ` +
  `${COLUMN_LOREBOOK_DESCRIPTION} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_LOREBOOK_ENABLED} INTEGER NOT NULL DEFAULT 1, ` +
  `${COLUMN_LOREBOOK_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_LOREBOOK_UPDATED_AT} INTEGER NOT NULL` +
  `)`;

// ===== v2: Lorebook Entries Table =====
const CREATE_LOREBOOK_ENTRIES_TABLE: string =
  `CREATE TABLE IF NOT EXISTS ${TABLE_LOREBOOK_ENTRIES} (` +
  `${COLUMN_ENTRY_ID} TEXT PRIMARY KEY NOT NULL, ` +
  `${COLUMN_ENTRY_LOREBOOK_ID} TEXT NOT NULL, ` +
  `${COLUMN_ENTRY_NAME} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_ENTRY_KEYS_JSON} TEXT NOT NULL DEFAULT '[]', ` +
  `${COLUMN_ENTRY_SECONDARY_KEYS_JSON} TEXT NOT NULL DEFAULT '[]', ` +
  `${COLUMN_ENTRY_CONTENT} TEXT NOT NULL DEFAULT '', ` +
  `${COLUMN_ENTRY_ENABLED} INTEGER NOT NULL DEFAULT 1, ` +
  `${COLUMN_ENTRY_CONSTANT} INTEGER NOT NULL DEFAULT 0, ` +
  `${COLUMN_ENTRY_SELECTIVE} INTEGER NOT NULL DEFAULT 0, ` +
  `${COLUMN_ENTRY_POSITION} TEXT NOT NULL, ` +
  `${COLUMN_ENTRY_PRIORITY} INTEGER NOT NULL DEFAULT 0, ` +
  `${COLUMN_ENTRY_CREATED_AT} INTEGER NOT NULL, ` +
  `${COLUMN_ENTRY_UPDATED_AT} INTEGER NOT NULL` +
  `)`;

// ===== v2: Lorebook Indexes =====
const CREATE_INDEX_LOREBOOKS_UPDATED_AT: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_LOREBOOKS_UPDATED_AT} ` +
  `ON ${TABLE_LOREBOOKS}(${COLUMN_LOREBOOK_UPDATED_AT})`;

const CREATE_INDEX_LOREBOOKS_ENABLED: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_LOREBOOKS_ENABLED} ` +
  `ON ${TABLE_LOREBOOKS}(${COLUMN_LOREBOOK_ENABLED})`;

const CREATE_INDEX_LOREBOOK_ENTRIES_LOREBOOK_ID: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_LOREBOOK_ENTRIES_LOREBOOK_ID} ` +
  `ON ${TABLE_LOREBOOK_ENTRIES}(${COLUMN_ENTRY_LOREBOOK_ID})`;

const CREATE_INDEX_LOREBOOK_ENTRIES_LOREBOOK_PRIORITY: string =
  `CREATE INDEX IF NOT EXISTS ${INDEX_LOREBOOK_ENTRIES_LOREBOOK_PRIORITY} ` +
  `ON ${TABLE_LOREBOOK_ENTRIES}(${COLUMN_ENTRY_LOREBOOK_ID}, ${COLUMN_ENTRY_PRIORITY} DESC, ${COLUMN_ENTRY_CREATED_AT} ASC, ${COLUMN_ENTRY_ID} ASC)`;

export const VERSION_1_STATEMENTS: string[] = [
  CREATE_CHARACTERS_TABLE,
  CREATE_CHATS_TABLE,
  CREATE_MESSAGES_TABLE,
  CREATE_INDEX_CHATS_UPDATED_AT,
  CREATE_INDEX_CHATS_CHARACTER_ID,
  CREATE_INDEX_MESSAGES_CHAT_SEQUENCE,
  CREATE_INDEX_MESSAGES_CHAT_CREATED
];

/** v1→v2 迁移 SQL,仅创建新表和索引,不修改旧数据 */
export const V1_TO_V2_STATEMENTS: string[] = [
  CREATE_LOREBOOKS_TABLE,
  CREATE_LOREBOOK_ENTRIES_TABLE,
  CREATE_INDEX_LOREBOOKS_UPDATED_AT,
  CREATE_INDEX_LOREBOOKS_ENABLED,
  CREATE_INDEX_LOREBOOK_ENTRIES_LOREBOOK_ID,
  CREATE_INDEX_LOREBOOK_ENTRIES_LOREBOOK_PRIORITY
];

/** v2 完整 Schema(新安装使用) */
export const CURRENT_SCHEMA_STATEMENTS: string[] = [
  CREATE_CHARACTERS_TABLE,
  CREATE_CHATS_TABLE,
  CREATE_MESSAGES_TABLE,
  CREATE_LOREBOOKS_TABLE,
  CREATE_LOREBOOK_ENTRIES_TABLE,
  CREATE_INDEX_CHATS_UPDATED_AT,
  CREATE_INDEX_CHATS_CHARACTER_ID,
  CREATE_INDEX_MESSAGES_CHAT_SEQUENCE,
  CREATE_INDEX_MESSAGES_CHAT_CREATED,
  CREATE_INDEX_LOREBOOKS_UPDATED_AT,
  CREATE_INDEX_LOREBOOKS_ENABLED,
  CREATE_INDEX_LOREBOOK_ENTRIES_LOREBOOK_ID,
  CREATE_INDEX_LOREBOOK_ENTRIES_LOREBOOK_PRIORITY
];

export function getSchemaStatements(version: number): string[] {
  if (version === 1) {
    return [...VERSION_1_STATEMENTS];
  }
  if (version === 2) {
    return [...CURRENT_SCHEMA_STATEMENTS];
  }
  return [];
}

export function getCreateTableStatements(): string[] {
  return [
    CREATE_CHARACTERS_TABLE,
    CREATE_CHATS_TABLE,
    CREATE_MESSAGES_TABLE,
    CREATE_LOREBOOKS_TABLE,
    CREATE_LOREBOOK_ENTRIES_TABLE
  ];
}

export function getCreateIndexStatements(): string[] {
  return [
    CREATE_INDEX_CHATS_UPDATED_AT,
    CREATE_INDEX_CHATS_CHARACTER_ID,
    CREATE_INDEX_MESSAGES_CHAT_SEQUENCE,
    CREATE_INDEX_MESSAGES_CHAT_CREATED,
    CREATE_INDEX_LOREBOOKS_UPDATED_AT,
    CREATE_INDEX_LOREBOOKS_ENABLED,
    CREATE_INDEX_LOREBOOK_ENTRIES_LOREBOOK_ID,
    CREATE_INDEX_LOREBOOK_ENTRIES_LOREBOOK_PRIORITY
  ];
}
