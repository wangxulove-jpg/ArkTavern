// ===== v12: Chat Memory 多层记忆扩展 =====
/**
 * v11→v12 迁移用的 ALTER TABLE 语句(仅迁移时使用)。
 * 新安装时通过 V12_SCHEMA_STATEMENTS 执行,此处 ALTER 会被包含在 V12_SCHEMA_STATEMENTS 中
 * 以保证新安装的 chat_memories 表也拥有 v12 字段(表由 v7→v8 迁移 DDL 以 v8 字段创建)。
 */
export const V11_TO_V12_ALTER_STATEMENTS: string[] = [
  `ALTER TABLE ${TABLE_CHAT_MEMORIES} ADD COLUMN ${COLUMN_MEMORY_TYPE} TEXT NOT NULL DEFAULT 'rolling'`,
  `ALTER TABLE ${TABLE_CHAT_MEMORIES} ADD COLUMN ${COLUMN_MEMORY_TITLE} TEXT NOT NULL DEFAULT ''`,
  `ALTER TABLE ${TABLE_CHAT_MEMORIES} ADD COLUMN ${COLUMN_MEMORY_DETAIL} TEXT NOT NULL DEFAULT ''`,
  `ALTER TABLE ${TABLE_CHAT_MEMORIES} ADD COLUMN ${COLUMN_MEMORY_IMPORTANCE} INTEGER NOT NULL DEFAULT 0`,
  `ALTER TABLE ${TABLE_CHAT_MEMORIES} ADD COLUMN ${COLUMN_MEMORY_KEYWORDS_JSON} TEXT NOT NULL DEFAULT '[]'`,
  `ALTER TABLE ${TABLE_CHAT_MEMORIES} ADD COLUMN ${COLUMN_MEMORY_SOURCE_HASH} TEXT NOT NULL DEFAULT ''`,
  `ALTER TABLE ${TABLE_CHAT_MEMORIES} ADD COLUMN ${COLUMN_MEMORY_INVALIDATED} INTEGER NOT NULL DEFAULT 0`
];

/**
 * v11→v12 迁移 SQL(ALTER + 新索引)。
 * - ALTER:为 chat_memories 表添加多层记忆字段
 * - 旧 Memory 记录默认 memory_type='rolling'、invalidated=0,保持兼容
 * - 新索引:按 branch_id + memory_type + invalidated 查询有效记忆
 */
export const V11_TO_V12_DDL_STATEMENTS: string[] = [
  ...V11_TO_V12_ALTER_STATEMENTS,
  CREATE_INDEX_CHAT_MEMORIES_BRANCH_TYPE
];

/**
 * v11→v12 数据迁移 SQL(仅升级时执行,新安装时表为空不需要)。
 * 将旧 Memory 记录的 memory_type 从默认 'rolling' 改为 'legacy',
 * 以明确标识旧系统生成的摘要,与 v12 新生成的 rolling 记忆区分。
 * - 旧摘要保留 summary / enabled / range 等字段不变
 * - 旧摘要仍可注入 Prompt(通过 MemoryLayersInjection.legacy)
 * - 用户可在记忆管理页看到旧摘要来源
 */
export const V11_TO_V12_DATA_MIGRATION_STATEMENTS: string[] = [
  `UPDATE ${TABLE_CHAT_MEMORIES} SET ${COLUMN_MEMORY_TYPE} = 'legacy' WHERE ${COLUMN_MEMORY_TYPE} = 'rolling'`
];

/** v12 完整 Schema(新安装使用)。
 *  注意:chat_memories 表由 V7_TO_V8_DDL_STATEMENTS 以 v8 字段创建,
 *  此处通过 V11_TO_V12_ALTER_STATEMENTS 补齐 v12 字段,保证新安装也拥有完整 v12 结构。
 *  新安装时表为空,不需要执行 DATA_MIGRATION。 */
export const V12_SCHEMA_STATEMENTS: string[] = [
  ...V11_SCHEMA_STATEMENTS,
  ...V11_TO_V12_DDL_STATEMENTS
];

export function getSchemaStatements(version: number): string[] {
  if (version === 1) {
    return [...VERSION_1_STATEMENTS];
  }
  if (version === 2) {
    return [...VERSION_1_STATEMENTS, ...V1_TO_V2_STATEMENTS];
  }
  if (version === 3) {
    return [...V3_SCHEMA_STATEMENTS];
  }
  if (version === 4) {
    return [...V4_SCHEMA_STATEMENTS];
  }
  if (version === 5) {
    return [...V5_SCHEMA_STATEMENTS];
  }
  if (version === 6) {
    return [...V6_SCHEMA_STATEMENTS];
  }
  if (version === 7) {
    return [...V7_SCHEMA_STATEMENTS];
  }
  if (version === 8) {
    return [...V8_SCHEMA_STATEMENTS];
  }
  if (version === 9) {
    return [...V9_SCHEMA_STATEMENTS];
  }
  if (version === 10) {
    return [...V10_SCHEMA_STATEMENTS];
  }
  if (version === 11) {
    return [...V11_SCHEMA_STATEMENTS];
  }
  if (version === 12) {
    return [...V12_SCHEMA_STATEMENTS];
  }
  return [];
}

