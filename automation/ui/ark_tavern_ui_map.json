        },
        "validate": {
          "componentId": "humanoidMapping.validate",
          "text": "验证"
        },
        "save": {
          "componentId": "humanoidMapping.save",
          "text": "保存"
        }
      }
    }
  },
  "automationGuidelines": {
    "beforeAutomation": "必须先读取本文件,优先使用 componentId 定位",
    "coordinateFallback": "坐标仅作为参考设备分辨率下的 fallback,其他分辨率需重新 dump",
    "dynamicLists": "模型库卡片和动作卡片通过 id 前缀定位,不保存固定坐标",
    "afterLayoutChange": "页面布局或按钮改动时,必须在同一个提交中更新本文件",
    "cleanup": "UI 自动化完成后必须删除临时 dump 和截图,只保留正式验收截图",
    "inconsistency": "如果 UI map 与当前页面不一致,先更新 UI map,再继续自动化"
