{
  "schemaVersion": 1,
  "updatedAt": "2026-07-24",
  "referenceDevice": {
    "width": 1224,
    "height": 2776,
    "orientation": "portrait",
    "note": "参考设备分辨率,坐标 fallback 仅在该分辨率下近似有效"
  },
  "rules": {
    "selectorPriority": [
      "componentId",
      "accessibilityText",
      "text",
      "fallbackCenter"
    ],
    "coordinatesAreFallbackOnly": true,
    "dynamicListById": "动态列表(模型库卡片/动作卡片)通过 item id 前缀定位,不保存固定坐标",
    "updatePolicy": "页面布局或按钮改动时,必须在同一个提交中更新本文件"
  },
  "pages": {
    "Index": {
      "route": "pages/Index",
      "title": "方舟酒馆",
      "entryPaths": [
        "应用启动默认页",
        "router.back() 从任意二级页面返回"
      ],
      "returnMethod": "系统返回键 / router.back()",
      "controls": {
        "tabCharacter": {
          "text": "角色卡",
          "note": "HdsTabs 第 0 个 Tab"
        },
        "tabChatSession": {
          "text": "对话记录",
          "note": "HdsTabs 第 1 个 Tab"
        },
        "tabMarket": {
          "text": "市场",
          "note": "HdsTabs 第 2 个 Tab"
        },
        "tabSettings": {
          "text": "设置",
          "note": "HdsTabs 第 3 个 Tab"
        },
        "entry3DPoc": {
          "text": "3D 渲染 PoC",
          "container": "SettingsRootView.entryCard",
          "note": "设置 Tab 列表项,点击跳转 pages/Character3DPocPage"
        }
      }
    },
    "Character3DPocPage": {
      "route": "pages/Character3DPocPage",
      "title": "3D 渲染 PoC",
      "entryPaths": [
        "设置 Tab -> 3D 渲染 PoC",
        "动作管理 -> 导入模型(跳转至此页)"
      ],
      "returnMethod": "左上角返回按钮(poc.back) 或 router.back()",
      "controls": {
        "back": {
          "componentId": "poc.back",
          "icon": "sys.symbol.chevron_left"
        },
        "importFile": {
          "componentId": "poc.importFile",
          "text": "导入文件",
          "note": "T-4.2: 调用 AvatarLibraryService.importAndActivate,导入后进入模型库"
        },
        "clearModel": {
          "componentId": "poc.clearModel",
          "text": "清除模型"
        },
        "actionManager": {
          "componentId": "poc.actionManager",
          "text": "动作管理",
          "note": "跳转 pages/Character3DActionManagerPage"
        },
        "openAvatarLibrary": {
          "componentId": "poc.openAvatarLibrary",
          "text": "模型库",
          "note": "跳转 pages/AvatarLibraryPage"
        },
        "play": {
          "componentId": "poc.play",
          "text": "播放"
        },
        "pause": {
          "componentId": "poc.pause",
          "text": "暂停"
        },
        "stop": {
          "componentId": "poc.stop",
          "text": "停止"
        },
        "resetView": {
          "componentId": "poc.resetView",
          "text": "重置视角"
        },
        "autoFit": {
          "componentId": "poc.autoFit",
          "text": "自动适配"
        },
        "reload": {
          "componentId": "poc.reload",
          "text": "重新加载"
        },
        "fitView": {
          "componentId": "poc.fitView",
          "text": "适配视图"
        },
        "loadDiagnostics": {
          "componentId": "poc.loadDiagnostics",
